  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">CueController – Threshold cue (lines, beat, chevron)</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject camera {"hint":"Camera SceneObject; its world position and view direction are sampled every frame"}'
    - '// @input SceneObject doorwaysRoot {"hint":"Parent of the Doorway components (searched recursively)"}'
    - '// @input SceneObject cueLinesRoot {"hint":"Parent of the floor lines; child 0 is the farthest line"}'
    - '// @input Component.AudioComponent beatAudio {"hint":"Tick sound; played once per beat as spatial sound from the marked doorway"}'
    - '// @input SceneObject chevronRoot {"hint":"Look-down chevron root (bars + text), built facing +Z"}'
    - "// @input Component.Text chevronText {\"hint\":\"The chevron's LOOK DOWN text\"}"
    - '// @input SceneObject previewOnlyRoot {"hint":"Preview-only stand-in room; disabled on device"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float lineSpacingCm = 40 {"hint":"Distance between lines, cm (setup panel slider)", "widget":"slider", "min":20, "max":80, "step":5}'
    - '// @input float beatBpm = 90 {"hint":"Beat speed, BPM (setup panel slider)", "widget":"slider", "min":60, "max":120, "step":1}'
    - '// @input float firstLineDistanceCm = 250 {"hint":"Distance from the cue-start point to the farthest line, cm (setup panel slider)", "widget":"slider", "min":100, "max":350, "step":10}'
    - '// @input vec3 lineColor = {0,1,1} {"hint":"Line colour", "widget":"color"}'
    - '// @input vec3 chevronColor = {0.92,0.96,1} {"hint":"Chevron and text colour (light; the display is additive)", "widget":"color"}'
    - '// @input float beatVolume = 0.6 {"hint":"Beat volume (constant; it only fades out)", "widget":"slider", "min":0.05, "max":1, "step":0.05}'
    - "// @input float verticalFovDeg = 37 {\"hint\":\"Display height used for 'farthest line in view', degrees (SPECS ~37)\", \"widget\":\"slider\", \"min\":20, \"max\":60, \"step\":0.5}"
    - '// @input float nominalEyeHeightCm = 150 {"hint":"Eye height assumed when no floor is detected, cm"}'
    - '// @input float probeIntervalS = 0.2 {"hint":"Seconds between floor probe rays"}'
    - '// @input float probeLengthCm = 600 {"hint":"Floor probe ray length, cm"}'
    - '// @input float minFloorDropCm = 50 {"hint":"A floor hit must be at least this far below the eyes, cm"}'
    - '// @input bool debugLogs {"hint":"Print state changes (never positions)"}'
    - '// @ui {"widget":"group_end"}'
